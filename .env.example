# Local development:
# - `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL and NEXT_PUBLIC_CONVEX_SITE_URL
# - `npm run dev` runs the local Convex + Next.js workflow
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public app origin.
# Used by Next.js routes, Meta OAuth callbacks, and tracked redirect links.
SITE_URL=http://localhost:3000

# Hosted builds only.
# Vercel/CI uses this to run `npx convex deploy --cmd "npm run build"`.
CONVEX_DEPLOY_KEY=

# Convex Auth / Google OAuth.
# Set these on the Convex deployment for production.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Instagram / Meta.
# Set these on the Convex deployment for production.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Generated by `npx @convex-dev/auth` on the Convex deployment.
# Do not hand-edit unless you know exactly why.
# JWT_PRIVATE_KEY=
# JWKS=
