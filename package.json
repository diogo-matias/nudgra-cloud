{
  "name": "nudgra",
  "version": "0.1.0",
  "description": "Operator-owned Instagram automation app built with Next.js and Convex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaikoCode/nudgra-convex.git"
  },
  "bugs": {
    "url": "https://github.com/MaikoCode/nudgra-convex/issues"
  },
  "homepage": "https://github.com/MaikoCode/nudgra-convex#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dev --once --run-sh \"node setup.mjs --once\" && convex dashboard",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"convex/_generated/**\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "@convex-dev/migrations": "^0.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.36.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.2.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.47",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.10",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "packageManager": "npm@11.4.1"
}
